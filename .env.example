# Node.js 22.13+ and PostgreSQL 16+. Never commit .env.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgres://tapcart@127.0.0.1:55435/tapcart
# Must be a separate disposable database for integration/concurrency tests.
TEST_DATABASE_URL=postgres://tapcart@127.0.0.1:55435/tapcart_test
# Development fixture seeding is separately gated; enable only for local demo data.
# ALLOW_DEVELOPMENT_SEED=true
# Development simulator. Server must also be outside production.
ALLOW_DEVELOPMENT_PAYMENTS=true
# Optional on-device/private local language model via Ollama (not required).
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Production Docker Compose requires a strong unique database password:
# POSTGRES_PASSWORD=replace-with-a-long-random-password

# Optional Stripe hosted payments (both required to enable card checkout).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Required in production: independent random 32-byte keys (64 hexadecimal characters).
# SECURITY_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
# NFC_MASTER_KEY=generate-a-different-openssl-rand-hex-32
# Email: capture is development-only and never reports SMTP delivery.
EMAIL_MODE=capture
# For production use EMAIL_MODE=smtp with a real provider, or disabled explicitly.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=TapCart <receipts@example.com>
# SMTP_USER=provider-user
# SMTP_PASSWORD=provider-password
# Provision public local model weights with npm run ai:models before inference.
# AI_MODEL_CACHE=.cache/models
# OCR_MODEL_CACHE=.cache/ocr
# AI_ALLOW_MODEL_DOWNLOAD=false
