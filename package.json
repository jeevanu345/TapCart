{
  "name": "tapcart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Transactional NFC retail with a React client and Node.js API",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.research.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json && node scripts/copy-migrations.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "db:migrate": "tsx --env-file-if-exists=.env server/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env server/scripts/seed.ts",
    "db:local": "bash scripts/local-db.sh",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint client/src server research e2e scripts --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "research:field": "tsx research/field-server.ts",
    "research:analyze": "tsx research/field-analysis.ts",
    "research:benchmark": "tsx --env-file-if-exists=.env research/benchmark.ts",
    "db:create-admin": "tsx --env-file-if-exists=.env server/scripts/create-admin.ts",
    "ai:models": "tsx server/scripts/ai-models.ts",
    "research:formal": "bash research/formal/run.sh"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@napi-rs/canvas": "^1.1.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "aes-cmac": "^4.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "otplib": "^13.6.0",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.16.3",
    "pino": "^10.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "recharts": "^3.3.0",
    "stripe": "^23.1.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^13.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.6.2",
    "smtp-server": "^3.21.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
